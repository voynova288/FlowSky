# Copy to .env.local locally; never commit real secrets.
# Provider selection. DeepSeek remains the default; OpenAI is optional.
LIUKONG_PROVIDER=deepseek

# Provider API keys. Leave blank when entering BYOK in the UI.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# OpenAI-compatible endpoints.
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_BASE_URL=https://api.openai.com/v1

# Models.
LIUKONG_DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
LIUKONG_DEEPSEEK_COMPLEX_MODEL=deepseek-v4-pro
LIUKONG_OPENAI_CHAT_MODEL=gpt-4o-mini
LIUKONG_OPENAI_COMPLEX_MODEL=gpt-4o

# Local server: local-first mode refuses non-loopback hosts.
LIUKONG_HOST=127.0.0.1
LIUKONG_PORT=3000
LIUKONG_REQUIRE_LOCAL_TOKEN=true
LIUKONG_ALLOW_NON_LOOPBACK=false
LIUKONG_MAX_BODY_BYTES=1000000

# Local data. Supports ~ expansion.
LIUKONG_DATA_DIR=~/.liukong

# Safety/privacy.
LIUKONG_ENABLE_HIGH_RISK_TOOLS=false
LIUKONG_TELEMETRY=false
LIUKONG_DEBUG_PROMPTS=false
